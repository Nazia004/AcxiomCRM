@model IEnumerable<Customer>
@{
    ViewData["Title"] = "Customer Report";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-0">Customer Master Report</h3>
        <p class="text-muted small mb-0">Comprehensive record list for accounts and assigned sales owners.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Customers" asp-route-format="csv" asp-route-status="@ViewBag.Status" class="btn btn-outline-success btn-sm">
            <i class="bi bi-file-earmark-spreadsheet me-1"></i>Export CSV
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back</a>
    </div>
</div>

<div class="card crm-card p-3 mb-4">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-4">
            <select name="status" class="form-select form-select-sm">
                <option value="">All Statuses</option>
                <option value="Active" selected="@(ViewBag.Status == "Active")">Active Only</option>
                <option value="Inactive" selected="@(ViewBag.Status == "Inactive")">Inactive Only</option>
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-secondary btn-sm w-100">Filter</button>
        </div>
    </form>
</div>

<div class="card crm-card">
    <div class="table-responsive">
        <table class="table table-hover table-custom align-middle mb-0">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Customer Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Company</th>
                    <th>Status</th>
                    <th>Owner</th>
                    <th>Created Date</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td><span class="badge bg-light text-dark border font-monospace">@c.CustomerCode</span></td>
                        <td class="fw-semibold">@c.CustomerName</td>
                        <td>@c.Email</td>
                        <td>@c.Phone</td>
                        <td>@(c.CompanyName ?? "—")</td>
                        <td><span class="badge @(c.Status == "Active" ? "bg-success" : "bg-secondary")">@c.Status</span></td>
                        <td>@(c.Owner?.FullName ?? c.CreatedBy ?? "Unassigned")</td>
                        <td>@c.CreatedDate.ToString("yyyy-MM-dd")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
