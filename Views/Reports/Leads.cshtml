@model IEnumerable<Lead>
@{
    ViewData["Title"] = "Lead Report";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-0">Lead Generation Report</h3>
        <p class="text-muted small mb-0">Tracking source effectiveness, priority distributions, and conversion statuses.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Leads" asp-route-format="csv" asp-route-status="@ViewBag.Status" asp-route-source="@ViewBag.Source" class="btn btn-outline-success btn-sm">
            <i class="bi bi-file-earmark-spreadsheet me-1"></i>Export CSV
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back</a>
    </div>
</div>

<div class="card crm-card p-3 mb-4">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-3">
            <select name="status" class="form-select form-select-sm">
                <option value="">All Statuses</option>
                @foreach (var s in LeadStatus.All)
                {
                    <option value="@s" selected="@(ViewBag.Status == s)">@s</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <select name="source" class="form-select form-select-sm">
                <option value="">All Sources</option>
                <option value="Website" selected="@(ViewBag.Source == "Website")">Website</option>
                <option value="Referral" selected="@(ViewBag.Source == "Referral")">Referral</option>
                <option value="Cold Call" selected="@(ViewBag.Source == "Cold Call")">Cold Call</option>
                <option value="Advertisement" selected="@(ViewBag.Source == "Advertisement")">Advertisement</option>
                <option value="Event" selected="@(ViewBag.Source == "Event")">Event</option>
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-secondary btn-sm w-100">Filter</button>
        </div>
    </form>
</div>

<div class="card crm-card">
    <div class="table-responsive">
        <table class="table table-hover table-custom align-middle mb-0">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Lead Name</th>
                    <th>Email</th>
                    <th>Company</th>
                    <th>Source</th>
                    <th>Status</th>
                    <th>Priority</th>
                    <th>Expected Value</th>
                    <th>Assigned To</th>
                    <th>Conversion</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var l in Model)
                {
                    <tr>
                        <td><span class="badge bg-light text-dark border font-monospace">@l.LeadCode</span></td>
                        <td class="fw-semibold">@l.LeadName</td>
                        <td>@l.Email</td>
                        <td>@(l.CompanyName ?? "—")</td>
                        <td><span class="badge bg-light text-dark border">@l.Source</span></td>
                        <td><span class="badge @(l.Status == LeadStatus.Converted ? "bg-success" : l.Status == LeadStatus.Lost ? "bg-danger" : "bg-primary")">@l.Status</span></td>
                        <td>@l.Priority</td>
                        <td class="fw-bold text-dark">@l.ExpectedValue.ToString("C0")</td>
                        <td>@(l.AssignedUser?.FullName ?? "Unassigned")</td>
                        <td>
                            @if (l.ConvertedDate.HasValue)
                            {
                                <span class="badge bg-success-subtle text-success border border-success"><i class="bi bi-check-circle me-1"></i>Converted</span>
                            }
                            else
                            {
                                <span class="text-muted small">Open</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
