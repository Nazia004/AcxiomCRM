@model IEnumerable<Opportunity>
@{
    ViewData["Title"] = "Pipeline Report";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-0">Sales Pipeline & Forecasting Report</h3>
        <p class="text-muted small mb-0">Stage distribution, unweighted and probability-weighted pipeline valuations.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Pipeline" asp-route-format="csv" asp-route-stage="@ViewBag.Stage" class="btn btn-outline-success btn-sm">
            <i class="bi bi-file-earmark-spreadsheet me-1"></i>Export CSV
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back</a>
    </div>
</div>

<!-- Valuation Summary -->
<div class="row g-3 mb-4">
    <div class="col-md-6 col-lg-3">
        <div class="card crm-card p-3 border-start border-4 border-primary">
            <span class="text-muted small text-uppercase">Total Pipeline Value</span>
            <h4 class="fw-bold text-primary mb-0 mt-1">@(((decimal)ViewBag.TotalAmount).ToString("C0"))</h4>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="card crm-card p-3 border-start border-4 border-success">
            <span class="text-muted small text-uppercase">Total Weighted Value</span>
            <h4 class="fw-bold text-success mb-0 mt-1">@(((decimal)ViewBag.TotalWeighted).ToString("C0"))</h4>
        </div>
    </div>
</div>

<div class="card crm-card p-3 mb-4">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-4">
            <select name="stage" class="form-select form-select-sm">
                <option value="">All Pipeline Stages</option>
                @foreach (var stg in OpportunityStage.All)
                {
                    <option value="@stg" selected="@(ViewBag.Stage == stg)">@stg</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-secondary btn-sm w-100">Filter</button>
        </div>
    </form>
</div>

<div class="card crm-card">
    <div class="table-responsive">
        <table class="table table-hover table-custom align-middle mb-0">
            <thead>
                <tr>
                    <th>Opportunity Name</th>
                    <th>Customer</th>
                    <th>Amount ($)</th>
                    <th>Stage</th>
                    <th>Probability</th>
                    <th>Weighted Value ($)</th>
                    <th>Expected Close</th>
                    <th>Owner</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in Model)
                {
                    <tr>
                        <td class="fw-semibold">@o.OpportunityName</td>
                        <td>@(o.Customer?.CustomerName ?? "—")</td>
                        <td class="fw-bold text-dark">@o.Amount.ToString("C0")</td>
                        <td><span class="badge bg-primary">@o.Stage</span></td>
                        <td>@o.Probability%</td>
                        <td class="fw-bold text-success">@o.WeightedPipeline.ToString("C0")</td>
                        <td>@o.ExpectedCloseDate.ToString("yyyy-MM-dd")</td>
                        <td>@(o.AssignedUser?.FullName ?? "Unassigned")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
