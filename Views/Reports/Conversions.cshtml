@{
    ViewData["Title"] = "Conversion & Outcome Report";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-0">Sales & Conversion Analytics Report</h3>
        <p class="text-muted small mb-0">Measurement of lead-to-customer conversion efficiency and closed-deal win rates.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back</a>
</div>

<div class="row g-4 mb-4">
    <!-- Lead Conversion Metric -->
    <div class="col-md-6 col-lg-3">
        <div class="card crm-card p-3 border-start border-4 border-info">
            <span class="text-muted small text-uppercase">Total Captured Leads</span>
            <h3 class="fw-bold text-dark mt-1 mb-0">@ViewBag.TotalLeads</h3>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="card crm-card p-3 border-start border-4 border-success">
            <span class="text-muted small text-uppercase">Converted to Customer</span>
            <h3 class="fw-bold text-success mt-1 mb-0">@ViewBag.ConvertedLeads</h3>
            <small class="text-muted">Rate: @ViewBag.ConversionRate%</small>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="card crm-card p-3 border-start border-4 border-primary">
            <span class="text-muted small text-uppercase">Opportunities Won</span>
            <h3 class="fw-bold text-primary mt-1 mb-0">@ViewBag.WonOppsCount</h3>
            <small class="text-muted">Won Deals</small>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="card crm-card p-3 border-start border-4 border-success">
            <span class="text-muted small text-uppercase">Closed Won Revenue</span>
            <h3 class="fw-bold text-success mt-1 mb-0">@(((decimal)ViewBag.WonRevenue).ToString("C0"))</h3>
        </div>
    </div>
</div>

<div class="card crm-card p-4">
    <h5 class="fw-bold mb-3">Conversion Funnel Summary</h5>
    <div class="progress mb-3" style="height: 30px;">
        <div class="progress-bar bg-success fw-bold" role="progressbar" style="width: @(ViewBag.ConversionRate)%;" aria-valuenow="@ViewBag.ConversionRate" aria-valuemin="0" aria-valuemax="100">
            Converted: @ViewBag.ConversionRate%
        </div>
        <div class="progress-bar bg-secondary" role="progressbar" style="width: @(100 - ViewBag.ConversionRate)%;">
            Active / Nurturing / Lost
        </div>
    </div>
    <p class="text-muted small mb-0">
        Calculated from @ViewBag.TotalLeads total leads in your scope. @ViewBag.ConvertedLeads leads successfully graduated to Customer and Opportunity accounts.
    </p>
</div>
