@model Lead
@{
    ViewData["Title"] = "Delete Lead";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card crm-card p-4 border-danger">
            <div class="text-center mb-3">
                <i class="bi bi-exclamation-triangle-fill text-danger fs-1"></i>
                <h4 class="fw-bold mt-2">Delete Lead</h4>
                <p class="text-muted small">Are you sure you want to delete this lead record? This action will remove the lead from your pipeline tracking.</p>
            </div>

            <div class="bg-light p-3 rounded mb-3">
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted small">Lead Name:</span>
                    <strong class="small">@Model.LeadName</strong>
                </div>
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted small">Code:</span>
                    <span class="font-monospace small">@Model.LeadCode</span>
                </div>
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted small">Email:</span>
                    <span class="small">@Model.Email</span>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="text-muted small">Expected Value:</span>
                    <span class="fw-bold text-success">@Model.ExpectedValue.ToString("C0")</span>
                </div>
            </div>

            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="LeadId" />
                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash-fill me-1"></i>Delete Lead
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
