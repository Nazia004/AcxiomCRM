@model Lead
@{
    ViewData["Title"] = "Create Lead";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card crm-card p-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4 class="fw-bold mb-0"><i class="bi bi-funnel text-primary me-2"></i>Create New Lead</h4>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back</a>
            </div>

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-4">
                        <label asp-for="LeadCode" class="form-label fw-semibold small"></label>
                        <input asp-for="LeadCode" class="form-control" readonly />
                    </div>

                    <div class="col-md-8">
                        <label asp-for="LeadName" class="form-label fw-semibold small"></label> <span class="text-danger">*</span>
                        <input asp-for="LeadName" class="form-control" placeholder="Contact or Lead Name" />
                        <span asp-validation-for="LeadName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label fw-semibold small"></label> <span class="text-danger">*</span>
                        <input asp-for="Email" class="form-control" placeholder="lead@company.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label fw-semibold small"></label> <span class="text-danger">*</span>
                        <input asp-for="Phone" class="form-control" placeholder="+1 555-019-3322" />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="CompanyName" class="form-label fw-semibold small"></label>
                        <input asp-for="CompanyName" class="form-control" placeholder="Company Name" />
                        <span asp-validation-for="CompanyName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Source" class="form-label fw-semibold small"></label>
                        <select asp-for="Source" class="form-select">
                            <option value="Website">Website</option>
                            <option value="Referral">Referral</option>
                            <option value="Cold Call">Cold Call</option>
                            <option value="Advertisement">Advertisement</option>
                            <option value="Event">Event</option>
                            <option value="Partner">Partner</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Status" class="form-label fw-semibold small"></label>
                        <select asp-for="Status" class="form-select">
                            @foreach (var s in LeadStatus.All)
                            {
                                <option value="@s">@s</option>
                            }
                        </select>
                        <span asp-validation-for="Status" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Priority" class="form-label fw-semibold small"></label>
                        <select asp-for="Priority" class="form-select">
                            <option value="Low">Low</option>
                            <option value="Medium">Medium</option>
                            <option value="High">High</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="ExpectedValue" class="form-label fw-semibold small"></label>
                        <input asp-for="ExpectedValue" class="form-control" type="number" min="0" step="100" />
                        <span asp-validation-for="ExpectedValue" class="text-danger small"></span>
                    </div>

                    @if (User.IsInRole(UserRoles.Admin) || User.IsInRole(UserRoles.Manager))
                    {
                        <div class="col-md-6">
                            <label asp-for="AssignedTo" class="form-label fw-semibold small">Assign Sales Executive</label>
                            <select asp-for="AssignedTo" class="form-select">
                                <option value="">-- Assign to Me / Unassigned --</option>
                                @if (ViewBag.Users != null)
                                {
                                    @foreach (var u in (IEnumerable<ApplicationUser>)ViewBag.Users)
                                    {
                                        <option value="@u.Id">@u.FullName (@u.Email)</option>
                                    }
                                }
                            </select>
                        </div>
                    }

                    <div class="col-12">
                        <label asp-for="Notes" class="form-label fw-semibold small"></label>
                        <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Lead background, budget discussions, next steps..."></textarea>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4 fw-semibold">
                        <i class="bi bi-save me-1"></i>Save Lead
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
