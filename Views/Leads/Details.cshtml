@model Lead
@{
    ViewData["Title"] = "Lead: " + Model.LeadName;
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <h3 class="fw-bold mb-0">@Model.LeadName</h3>
            <span class="badge badge-status @(Model.Status == LeadStatus.Converted ? "bg-success" : Model.Status == LeadStatus.Lost ? "bg-danger" : "bg-primary")">@Model.Status</span>
            <span class="badge bg-light text-dark border font-monospace">@Model.LeadCode</span>
        </div>
        <p class="text-muted small mb-0">Lead Qualification & Prospect Details</p>
    </div>
    <div class="d-flex gap-2 mt-2 mt-md-0">
        @if (Model.Status != LeadStatus.Converted)
        {
            <a asp-action="Convert" asp-route-id="@Model.LeadId" class="btn btn-success btn-sm">
                <i class="bi bi-arrow-repeat me-1"></i>Convert to Customer
            </a>
        }
        else if (Model.ConvertedCustomerId.HasValue)
        {
            <a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.ConvertedCustomerId.Value" class="btn btn-outline-success btn-sm">
                <i class="bi bi-person-check me-1"></i>View Customer Profile
            </a>
        }
        <a asp-controller="FollowUps" asp-action="Create" asp-route-leadId="@Model.LeadId" class="btn btn-outline-warning btn-sm">
            <i class="bi bi-calendar-plus me-1"></i>Follow-Up
        </a>
        <a asp-controller="Activities" asp-action="Create" asp-route-leadId="@Model.LeadId" class="btn btn-outline-info btn-sm">
            <i class="bi bi-card-checklist me-1"></i>Log Activity
        </a>
        <a asp-action="Edit" asp-route-id="@Model.LeadId" class="btn btn-primary btn-sm">
            <i class="bi bi-pencil me-1"></i>Edit
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back</a>
    </div>
</div>

<div class="row g-4">
    <!-- Left Column: Master Details -->
    <div class="col-lg-4">
        <div class="card crm-card p-3 mb-4">
            <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">Lead Information</h6>
            <dl class="row small mb-0">
                <dt class="col-sm-5 text-muted">Company</dt>
                <dd class="col-sm-7 fw-semibold">@(Model.CompanyName ?? "—")</dd>

                <dt class="col-sm-5 text-muted">Email</dt>
                <dd class="col-sm-7"><a href="mailto:@Model.Email">@Model.Email</a></dd>

                <dt class="col-sm-5 text-muted">Phone</dt>
                <dd class="col-sm-7">@Model.Phone</dd>

                <dt class="col-sm-5 text-muted">Source</dt>
                <dd class="col-sm-7"><span class="badge bg-light text-dark border">@Model.Source</span></dd>

                <dt class="col-sm-5 text-muted">Priority</dt>
                <dd class="col-sm-7">@Model.Priority</dd>

                <dt class="col-sm-5 text-muted">Expected Value</dt>
                <dd class="col-sm-7 fw-bold text-success">@Model.ExpectedValue.ToString("C0")</dd>

                <dt class="col-sm-5 text-muted">Assigned To</dt>
                <dd class="col-sm-7">@(Model.AssignedUser?.FullName ?? "Unassigned")</dd>

                <dt class="col-sm-5 text-muted">Created</dt>
                <dd class="col-sm-7">@Model.CreatedDate.ToString("g")</dd>

                @if (Model.ConvertedDate.HasValue)
                {
                    <dt class="col-sm-5 text-muted">Converted On</dt>
                    <dd class="col-sm-7 text-success fw-bold">@Model.ConvertedDate.Value.ToString("g")</dd>
                }
            </dl>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Notes))
        {
            <div class="card crm-card p-3">
                <h6 class="fw-bold text-dark border-bottom pb-2 mb-2">Notes</h6>
                <p class="small text-muted mb-0">@Model.Notes</p>
            </div>
        }
    </div>

    <!-- Right Column: Follow-ups and Activities -->
    <div class="col-lg-8">
        <!-- Follow-Ups -->
        <div class="card crm-card mb-4">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0"><i class="bi bi-clock-history text-warning me-2"></i>Follow-Ups (@Model.FollowUps.Count)</h6>
                <a asp-controller="FollowUps" asp-action="Create" asp-route-leadId="@Model.LeadId" class="btn btn-sm btn-outline-primary">+ Schedule</a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover table-sm align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Subject</th>
                            <th>Type</th>
                            <th>Date</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.FollowUps.Any())
                        {
                            @foreach (var f in Model.FollowUps)
                            {
                                <tr>
                                    <td class="fw-semibold">@f.Subject</td>
                                    <td><span class="badge bg-secondary">@f.FollowUpType</span></td>
                                    <td>@f.FollowUpDate.ToString("g")</td>
                                    <td><span class="badge @(f.Status == "Completed" ? "bg-success" : "bg-warning text-dark")">@f.Status</span></td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="4" class="text-center py-3 text-muted small">No follow-ups recorded for this lead.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Activities -->
        <div class="card crm-card">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0"><i class="bi bi-card-checklist text-info me-2"></i>Activities (@Model.Activities.Count)</h6>
                <a asp-controller="Activities" asp-action="Create" asp-route-leadId="@Model.LeadId" class="btn btn-sm btn-outline-primary">+ Log Activity</a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover table-sm align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Subject</th>
                            <th>Type</th>
                            <th>Date</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Activities.Any())
                        {
                            @foreach (var a in Model.Activities)
                            {
                                <tr>
                                    <td class="fw-semibold">@a.Subject</td>
                                    <td><span class="badge bg-info text-dark">@a.ActivityType</span></td>
                                    <td>@a.ActivityDate.ToString("g")</td>
                                    <td><span class="badge bg-success">@a.Status</span></td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="4" class="text-center py-3 text-muted small">No activities logged.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
