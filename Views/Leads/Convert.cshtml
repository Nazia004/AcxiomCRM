@model ConvertLeadViewModel
@{
    ViewData["Title"] = "Convert Lead";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card crm-card p-4 border-success">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="fw-bold mb-0 text-success">
                    <i class="bi bi-arrow-repeat me-2"></i>Convert Lead to Customer & Opportunity
                </h4>
                <a asp-action="Details" asp-route-id="@Model.LeadId" class="btn btn-outline-secondary btn-sm">Cancel</a>
            </div>
            <p class="text-muted small mb-4">
                Converting this lead will promote <strong>@Model.LeadName</strong> to an active Customer record and optionally spawn a qualified sales deal in your pipeline.
            </p>

            <form asp-action="Convert" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="LeadId" />
                <input type="hidden" asp-for="LeadCode" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                <div class="card bg-light border-0 p-3 mb-4">
                    <h6 class="fw-bold text-dark mb-3"><i class="bi bi-person-badge me-2 text-primary"></i>Customer Record Details</h6>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="LeadName" class="form-label fw-semibold small">Customer Name</label>
                            <input asp-for="LeadName" class="form-control" />
                            <span asp-validation-for="LeadName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CompanyName" class="form-label fw-semibold small"></label>
                            <input asp-for="CompanyName" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold small"></label>
                            <input asp-for="Email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label fw-semibold small"></label>
                            <input asp-for="Phone" class="form-control" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Address" class="form-label fw-semibold small"></label>
                            <input asp-for="Address" class="form-control" placeholder="Street Address" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="City" class="form-label fw-semibold small"></label>
                            <input asp-for="City" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="State" class="form-label fw-semibold small"></label>
                            <input asp-for="State" class="form-control" />
                        </div>
                    </div>
                </div>

                <div class="card bg-light border-0 p-3 mb-4">
                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" asp-for="CreateOpportunity" id="toggleOpp" />
                        <label class="form-check-label fw-bold text-dark" for="toggleOpp">Create Related Opportunity in Pipeline</label>
                    </div>

                    <div id="oppFields" class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="OpportunityName" class="form-label fw-semibold small"></label>
                            <input asp-for="OpportunityName" class="form-control" />
                            <span asp-validation-for="OpportunityName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Amount" class="form-label fw-semibold small"></label>
                            <input asp-for="Amount" class="form-control" type="number" min="1" step="100" />
                            <span asp-validation-for="Amount" class="text-danger small"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="ExpectedCloseDate" class="form-label fw-semibold small"></label>
                            <input asp-for="ExpectedCloseDate" class="form-control" type="date" />
                            <span asp-validation-for="ExpectedCloseDate" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                    <a asp-action="Details" asp-route-id="@Model.LeadId" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-success px-4 fw-semibold">
                        <i class="bi bi-check2-circle me-1"></i>Confirm Lead Conversion
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('toggleOpp').addEventListener('change', function () {
            document.getElementById('oppFields').style.display = this.checked ? 'flex' : 'none';
        });
    </script>
}
