@{
    ViewData["Title"] = "Access Denied";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-5 text-center">
        <div class="card crm-card p-5 shadow-sm border-warning">
            <i class="bi bi-shield-lock-fill text-warning" style="font-size: 4rem;"></i>
            <h3 class="fw-bold text-dark mt-3">Access Denied</h3>
            <p class="text-muted mt-2">
                You do not have the required role or authorization permissions to access this CRM resource.
            </p>
            <div class="alert alert-secondary small">
                Your role does not grant administrative privileges for this area.
            </div>
            <div class="mt-4">
                <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary">
                    <i class="bi bi-arrow-left me-1"></i>Back to Dashboard
                </a>
            </div>
        </div>
    </div>
</div>
