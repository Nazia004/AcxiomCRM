@{
    ViewData["Title"] = "Account Locked";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-5 text-center">
        <div class="card crm-card p-5 shadow-sm border-danger">
            <i class="bi bi-shield-x text-danger" style="font-size: 4rem;"></i>
            <h3 class="fw-bold text-danger mt-3">Account Locked Out</h3>
            <p class="text-muted mt-2">
                This account has been temporarily locked out due to multiple failed login attempts.
            </p>
            <div class="alert alert-warning small">
                <i class="bi bi-clock-history me-1"></i> Please wait <strong>15 minutes</strong> before attempting to log in again, or contact your System Administrator to unlock your account.
            </div>
            <div class="mt-4">
                <a asp-action="Login" class="btn btn-outline-primary">Return to Sign In</a>
            </div>
        </div>
    </div>
</div>
