@model Customer
@{
    ViewData["Title"] = "Customer: " + Model.CustomerName;
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <h3 class="fw-bold mb-0">@Model.CustomerName</h3>
            <span class="badge badge-status @(Model.Status == "Active" ? "bg-success" : "bg-secondary")">@Model.Status</span>
            <span class="badge bg-light text-dark border font-monospace">@Model.CustomerCode</span>
        </div>
        <p class="text-muted small mb-0">Customer Profile & Lifecycle Activity History</p>
    </div>
    <div class="d-flex gap-2 mt-2 mt-md-0">
        <a asp-controller="Opportunities" asp-action="Create" asp-route-customerId="@Model.CustomerId" class="btn btn-outline-success btn-sm">
            <i class="bi bi-cash me-1"></i>New Deal
        </a>
        <a asp-controller="FollowUps" asp-action="Create" asp-route-customerId="@Model.CustomerId" class="btn btn-outline-warning btn-sm">
            <i class="bi bi-calendar-plus me-1"></i>Schedule Follow-Up
        </a>
        <a asp-controller="Activities" asp-action="Create" asp-route-customerId="@Model.CustomerId" class="btn btn-outline-info btn-sm">
            <i class="bi bi-card-checklist me-1"></i>Log Activity
        </a>
        <a asp-action="Edit" asp-route-id="@Model.CustomerId" class="btn btn-primary btn-sm">
            <i class="bi bi-pencil me-1"></i>Edit
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back</a>
    </div>
</div>

<div class="row g-4">
    <!-- Left Column: Master Data -->
    <div class="col-lg-4">
        <div class="card crm-card p-3 mb-4">
            <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">Customer Information</h6>
            <dl class="row small mb-0">
                <dt class="col-sm-5 text-muted">Company</dt>
                <dd class="col-sm-7 fw-semibold">@(Model.CompanyName ?? "—")</dd>

                <dt class="col-sm-5 text-muted">Email</dt>
                <dd class="col-sm-7"><a href="mailto:@Model.Email">@Model.Email</a></dd>

                <dt class="col-sm-5 text-muted">Phone</dt>
                <dd class="col-sm-7">@Model.Phone</dd>

                <dt class="col-sm-5 text-muted">Address</dt>
                <dd class="col-sm-7">@(Model.Address ?? "—")</dd>

                <dt class="col-sm-5 text-muted">City / State</dt>
                <dd class="col-sm-7">@(string.IsNullOrEmpty(Model.City) ? "—" : $"{Model.City}, {Model.State}")</dd>

                <dt class="col-sm-5 text-muted">Owner</dt>
                <dd class="col-sm-7">@(Model.Owner?.FullName ?? Model.CreatedBy ?? "Unassigned")</dd>

                <dt class="col-sm-5 text-muted">Created</dt>
                <dd class="col-sm-7">@Model.CreatedDate.ToString("g")</dd>
            </dl>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Notes))
        {
            <div class="card crm-card p-3">
                <h6 class="fw-bold text-dark border-bottom pb-2 mb-2">Notes</h6>
                <p class="small text-muted mb-0">@Model.Notes</p>
            </div>
        }
    </div>

    <!-- Right Column: Related Deals, Follow-ups, Activities -->
    <div class="col-lg-8">
        <!-- Opportunities -->
        <div class="card crm-card mb-4">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0"><i class="bi bi-cash-stack text-success me-2"></i>Opportunities (@Model.Opportunities.Count)</h6>
                <a asp-controller="Opportunities" asp-action="Create" asp-route-customerId="@Model.CustomerId" class="btn btn-sm btn-outline-primary">+ Add Deal</a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover table-sm align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Deal Name</th>
                            <th>Amount</th>
                            <th>Stage</th>
                            <th>Probability</th>
                            <th>Close Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Opportunities.Any())
                        {
                            @foreach (var opp in Model.Opportunities)
                            {
                                <tr>
                                    <td>
                                        <a asp-controller="Opportunities" asp-action="Details" asp-route-id="@opp.OpportunityId" class="fw-semibold text-decoration-none">
                                            @opp.OpportunityName
                                        </a>
                                    </td>
                                    <td class="fw-bold text-dark">@opp.Amount.ToString("C0")</td>
                                    <td><span class="badge bg-primary">@opp.Stage</span></td>
                                    <td>@opp.Probability%</td>
                                    <td>@opp.ExpectedCloseDate.ToString("d")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="5" class="text-center py-3 text-muted small">No opportunities linked.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Follow-Ups -->
        <div class="card crm-card mb-4">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0"><i class="bi bi-clock-history text-warning me-2"></i>Follow-Ups (@Model.FollowUps.Count)</h6>
                <a asp-controller="FollowUps" asp-action="Create" asp-route-customerId="@Model.CustomerId" class="btn btn-sm btn-outline-primary">+ Schedule</a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover table-sm align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Subject</th>
                            <th>Type</th>
                            <th>Date</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.FollowUps.Any())
                        {
                            @foreach (var f in Model.FollowUps)
                            {
                                <tr>
                                    <td class="fw-semibold">@f.Subject</td>
                                    <td><span class="badge bg-secondary">@f.FollowUpType</span></td>
                                    <td>@f.FollowUpDate.ToString("g")</td>
                                    <td>
                                        <span class="badge @(f.Status == "Completed" ? "bg-success" : f.Status == "Planned" ? "bg-warning text-dark" : "bg-danger")">
                                            @f.Status
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="4" class="text-center py-3 text-muted small">No follow-ups recorded.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Activities -->
        <div class="card crm-card">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0"><i class="bi bi-card-checklist text-info me-2"></i>Recent Activities (@Model.Activities.Count)</h6>
                <a asp-controller="Activities" asp-action="Create" asp-route-customerId="@Model.CustomerId" class="btn btn-sm btn-outline-primary">+ Log Activity</a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover table-sm align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Subject</th>
                            <th>Type</th>
                            <th>Date</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Activities.Any())
                        {
                            @foreach (var a in Model.Activities)
                            {
                                <tr>
                                    <td class="fw-semibold">@a.Subject</td>
                                    <td><span class="badge bg-info text-dark">@a.ActivityType</span></td>
                                    <td>@a.ActivityDate.ToString("g")</td>
                                    <td><span class="badge bg-success">@a.Status</span></td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="4" class="text-center py-3 text-muted small">No activities logged.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
