@model Customer
@{
    ViewData["Title"] = "Deactivate Customer";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card crm-card p-4 border-danger">
            <div class="text-center mb-3">
                <i class="bi bi-exclamation-triangle-fill text-danger fs-1"></i>
                <h4 class="fw-bold mt-2">Deactivate Customer</h4>
                <p class="text-muted small">Are you sure you want to deactivate this customer account? This will mark the record as Inactive while preserving all historical deals and audit trails.</p>
            </div>

            <div class="bg-light p-3 rounded mb-3">
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted small">Customer Name:</span>
                    <strong class="small">@Model.CustomerName</strong>
                </div>
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted small">Customer Code:</span>
                    <span class="font-monospace small">@Model.CustomerCode</span>
                </div>
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted small">Email:</span>
                    <span class="small">@Model.Email</span>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="text-muted small">Current Status:</span>
                    <span class="badge @(Model.Status == "Active" ? "bg-success" : "bg-secondary")">@Model.Status</span>
                </div>
            </div>

            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="CustomerId" />
                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-person-x-fill me-1"></i>Confirm Deactivation
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
