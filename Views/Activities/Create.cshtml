@model Activity
@{
    ViewData["Title"] = "Log Activity";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card crm-card p-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4 class="fw-bold mb-0"><i class="bi bi-plus-circle text-primary me-2"></i>Log CRM Activity</h4>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back</a>
            </div>

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="ActivityType" class="form-label fw-semibold small"></label> <span class="text-danger">*</span>
                        <select asp-for="ActivityType" class="form-select">
                            @foreach (var t in ActivityTypes.All)
                            {
                                <option value="@t">@t</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ActivityDate" class="form-label fw-semibold small"></label> <span class="text-danger">*</span>
                        <input asp-for="ActivityDate" class="form-control" type="datetime-local" />
                        <span asp-validation-for="ActivityDate" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Subject" class="form-label fw-semibold small"></label> <span class="text-danger">*</span>
                        <input asp-for="Subject" class="form-control" placeholder="e.g. Discovery Call with Operations Director" />
                        <span asp-validation-for="Subject" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="CustomerId" class="form-label fw-semibold small">Related Customer</label>
                        <select asp-for="CustomerId" class="form-select">
                            <option value="">-- None / Select Customer --</option>
                            @if (ViewBag.Customers != null)
                            {
                                @foreach (var c in (IEnumerable<Customer>)ViewBag.Customers)
                                {
                                    <option value="@c.CustomerId" selected="@(Model.CustomerId == c.CustomerId)">@c.CustomerName (@c.CustomerCode)</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="LeadId" class="form-label fw-semibold small">Related Lead</label>
                        <select asp-for="LeadId" class="form-select">
                            <option value="">-- None / Select Lead --</option>
                            @if (ViewBag.Leads != null)
                            {
                                @foreach (var l in (IEnumerable<Lead>)ViewBag.Leads)
                                {
                                    <option value="@l.LeadId" selected="@(Model.LeadId == l.LeadId)">@l.LeadName (@l.LeadCode)</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Status" class="form-label fw-semibold small"></label>
                        <select asp-for="Status" class="form-select">
                            <option value="Completed">Completed</option>
                            <option value="Pending">Pending</option>
                            <option value="Cancelled">Cancelled</option>
                        </select>
                    </div>

                    @if (User.IsInRole(UserRoles.Admin) || User.IsInRole(UserRoles.Manager))
                    {
                        <div class="col-md-6">
                            <label asp-for="AssignedTo" class="form-label fw-semibold small">Assigned To</label>
                            <select asp-for="AssignedTo" class="form-select">
                                <option value="">-- Assign to Me / Unassigned --</option>
                                @if (ViewBag.Users != null)
                                {
                                    @foreach (var u in (IEnumerable<ApplicationUser>)ViewBag.Users)
                                    {
                                        <option value="@u.Id">@u.FullName (@u.Email)</option>
                                    }
                                }
                            </select>
                        </div>
                    }

                    <div class="col-12">
                        <label asp-for="Description" class="form-label fw-semibold small"></label>
                        <textarea asp-for="Description" class="form-control" rows="4" placeholder="Detailed notes, discussion topics, takeaways..."></textarea>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4 fw-semibold">
                        <i class="bi bi-save me-1"></i>Save Activity
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
