@model IEnumerable<Activity>
@{
    ViewData["Title"] = "Activity Log";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
    <div>
        <h3 class="fw-bold mb-0">Activities</h3>
        <p class="text-muted small mb-0">Log and review calls, meetings, emails, and CRM tasks.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary mt-2 mt-md-0">
        <i class="bi bi-plus-lg me-1"></i>Log Activity
    </a>
</div>

<!-- Filters -->
<div class="card crm-card p-3 mb-4">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-4">
            <select name="type" class="form-select">
                <option value="">All Activity Types</option>
                @foreach (var t in ActivityTypes.All)
                {
                    <option value="@t" selected="@(ViewBag.Type == t)">@t</option>
                }
            </select>
        </div>
        <div class="col-md-4">
            <select name="status" class="form-select">
                <option value="">All Statuses</option>
                <option value="Completed" selected="@(ViewBag.Status == "Completed")">Completed</option>
                <option value="Pending" selected="@(ViewBag.Status == "Pending")">Pending</option>
                <option value="Cancelled" selected="@(ViewBag.Status == "Cancelled")">Cancelled</option>
            </select>
        </div>
        <div class="col-md-4 d-flex gap-2">
            <button type="submit" class="btn btn-secondary flex-grow-1">
                <i class="bi bi-filter me-1"></i>Filter
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
        </div>
    </form>
</div>

<!-- Table -->
<div class="card crm-card">
    <div class="table-responsive">
        <table class="table table-hover table-custom align-middle mb-0">
            <thead>
                <tr>
                    <th>Type</th>
                    <th>Subject</th>
                    <th>Related Record</th>
                    <th>Date & Time</th>
                    <th>Status</th>
                    <th>Logged By</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        var typeIcon = item.ActivityType switch {
                            "Call" => "bi-telephone-fill text-primary",
                            "Meeting" => "bi-people-fill text-success",
                            "Email" => "bi-envelope-fill text-warning",
                            "Task" => "bi-check2-square text-info",
                            _ => "bi-card-checklist"
                        };

                        <tr>
                            <td>
                                <span class="d-inline-flex align-items-center gap-1 fw-semibold small">
                                    <i class="bi @typeIcon"></i> @item.ActivityType
                                </span>
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-id="@item.ActivityId" class="fw-semibold text-decoration-none">
                                    @item.Subject
                                </a>
                            </td>
                            <td>
                                @if (item.Customer != null)
                                {
                                    <a asp-controller="Customers" asp-action="Details" asp-route-id="@item.CustomerId" class="text-dark small">
                                        <i class="bi bi-building me-1"></i>@item.Customer.CustomerName
                                    </a>
                                }
                                else if (item.Lead != null)
                                {
                                    <a asp-controller="Leads" asp-action="Details" asp-route-id="@item.LeadId" class="text-dark small">
                                        <i class="bi bi-funnel me-1"></i>@item.Lead.LeadName
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted small">General</span>
                                }
                            </td>
                            <td><small>@item.ActivityDate.ToString("g")</small></td>
                            <td>
                                <span class="badge @(item.Status == "Completed" ? "bg-success" : "bg-secondary")">
                                    @item.Status
                                </span>
                            </td>
                            <td><small>@(item.AssignedUser?.FullName ?? "System")</small></td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@item.ActivityId" class="btn btn-outline-secondary" title="Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.ActivityId" class="btn btn-outline-primary" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-card-checklist fs-2 d-block mb-2"></i>
                            No activities logged yet.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (ViewBag.TotalPages > 1)
    {
        <div class="card-footer bg-white d-flex justify-content-between align-items-center py-2">
            <span class="small text-muted">Page @ViewBag.CurrentPage of @ViewBag.TotalPages (@ViewBag.TotalCount total records)</span>
            <ul class="pagination pagination-sm mb-0">
                @for (int p = 1; p <= ViewBag.TotalPages; p++)
                {
                    <li class="page-item @(p == ViewBag.CurrentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-type="@ViewBag.Type" asp-route-status="@ViewBag.Status">@p</a>
                    </li>
                }
            </ul>
        </div>
    }
</div>
