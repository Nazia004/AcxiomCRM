@model Opportunity
@{
    ViewData["Title"] = "Opportunity: " + Model.OpportunityName;
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <h3 class="fw-bold mb-0">@Model.OpportunityName</h3>
            <span class="badge badge-status @(Model.Status == "Won" ? "bg-success" : Model.Status == "Lost" ? "bg-danger" : "bg-primary")">@Model.Stage</span>
            <span class="badge bg-light text-dark border">@Model.Status</span>
        </div>
        <p class="text-muted small mb-0">Deal Pipeline Details & Weighted Valuation</p>
    </div>
    <div class="d-flex gap-2 mt-2 mt-md-0">
        <a asp-action="Edit" asp-route-id="@Model.OpportunityId" class="btn btn-primary btn-sm">
            <i class="bi bi-pencil me-1"></i>Edit Deal
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back to Pipeline</a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card crm-card p-4">
            <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">Deal Summary</h5>
            <dl class="row mb-0">
                <dt class="col-sm-5 text-muted">Customer</dt>
                <dd class="col-sm-7 fw-semibold">
                    @if (Model.Customer != null)
                    {
                        <a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.CustomerId">
                            @Model.Customer.CustomerName
                        </a>
                    }
                    else
                    {
                        <span>—</span>
                    }
                </dd>

                <dt class="col-sm-5 text-muted">Deal Value</dt>
                <dd class="col-sm-7 fw-bold text-primary fs-5">@Model.Amount.ToString("C0")</dd>

                <dt class="col-sm-5 text-muted">Win Probability</dt>
                <dd class="col-sm-7">
                    <div class="d-flex align-items-center gap-2">
                        <div class="progress flex-grow-1" style="height: 8px;">
                            <div class="progress-bar bg-success" style="width: @(Model.Probability)%"></div>
                        </div>
                        <span class="fw-semibold">@Model.Probability%</span>
                    </div>
                </dd>

                <dt class="col-sm-5 text-muted">Weighted Pipeline</dt>
                <dd class="col-sm-7 fw-bold text-success fs-5">@Model.WeightedPipeline.ToString("C0")</dd>

                <dt class="col-sm-5 text-muted">Stage</dt>
                <dd class="col-sm-7"><span class="badge bg-primary">@Model.Stage</span></dd>

                <dt class="col-sm-5 text-muted">Expected Close Date</dt>
                <dd class="col-sm-7">@Model.ExpectedCloseDate.ToString("MMMM dd, yyyy")</dd>

                <dt class="col-sm-5 text-muted">Opportunity Owner</dt>
                <dd class="col-sm-7">@(Model.AssignedUser?.FullName ?? "Unassigned")</dd>

                <dt class="col-sm-5 text-muted">Created</dt>
                <dd class="col-sm-7">@Model.CreatedDate.ToString("g")</dd>
            </dl>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card crm-card p-4 h-100">
            <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">Strategy & Notes</h5>
            <p class="text-muted">@(string.IsNullOrEmpty(Model.Notes) ? "No notes recorded for this deal." : Model.Notes)</p>

            <div class="mt-auto pt-3 border-top">
                <small class="text-muted d-block mb-2">Quick Pipeline Actions:</small>
                <div class="d-flex gap-2">
                    <a asp-controller="FollowUps" asp-action="Create" asp-route-customerId="@Model.CustomerId" class="btn btn-outline-warning btn-sm">
                        <i class="bi bi-calendar-event me-1"></i>Follow-Up with Client
                    </a>
                    <a asp-controller="Activities" asp-action="Create" asp-route-customerId="@Model.CustomerId" class="btn btn-outline-info btn-sm">
                        <i class="bi bi-telephone me-1"></i>Log Deal Call/Meeting
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
