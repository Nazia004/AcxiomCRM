@model DashboardViewModel
@{
    ViewData["Title"] = "CRM Dashboard";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">CRM Analytics Dashboard</h3>
        <p class="text-muted small mb-0">Overview of sales pipeline, active leads, and customer engagement.</p>
    </div>
    <!-- Date Filter Pills -->
    <div class="btn-group shadow-sm mt-2 mt-md-0" role="group">
        <a asp-action="Index" asp-route-dateFilter="All" class="btn btn-sm @(Model.DateFilter == "All" ? "btn-primary" : "btn-outline-secondary")">All Time</a>
        <a asp-action="Index" asp-route-dateFilter="Today" class="btn btn-sm @(Model.DateFilter == "Today" ? "btn-primary" : "btn-outline-secondary")">Today</a>
        <a asp-action="Index" asp-route-dateFilter="ThisWeek" class="btn btn-sm @(Model.DateFilter == "ThisWeek" ? "btn-primary" : "btn-outline-secondary")">This Week</a>
        <a asp-action="Index" asp-route-dateFilter="ThisMonth" class="btn btn-sm @(Model.DateFilter == "ThisMonth" ? "btn-primary" : "btn-outline-secondary")">This Month</a>
    </div>
</div>

<!-- KPI Cards Row 1: Pipeline & Follow-ups -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card crm-card p-3 h-100 border-start border-4 border-primary">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small text-uppercase fw-semibold">Total Pipeline</span>
                    <h3 class="fw-bold text-primary mb-0 mt-1">@Model.TotalPipelineValue.ToString("C0")</h3>
                    <small class="text-muted">Weighted: @Model.TotalWeightedPipelineValue.ToString("C0")</small>
                </div>
                <div class="p-3 bg-primary bg-opacity-10 text-primary rounded-circle">
                    <i class="bi bi-currency-dollar fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card crm-card p-3 h-100 border-start border-4 border-success">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small text-uppercase fw-semibold">Customers</span>
                    <h3 class="fw-bold text-dark mb-0 mt-1">@Model.TotalCustomers</h3>
                    <small class="text-success"><i class="bi bi-people me-1"></i>Active accounts</small>
                </div>
                <div class="p-3 bg-success bg-opacity-10 text-success rounded-circle">
                    <i class="bi bi-building fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card crm-card p-3 h-100 border-start border-4 border-info">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small text-uppercase fw-semibold">Total Leads</span>
                    <h3 class="fw-bold text-dark mb-0 mt-1">@Model.TotalLeads</h3>
                    <small class="text-info"><i class="bi bi-funnel me-1"></i>@Model.OpenLeads Open Leads</small>
                </div>
                <div class="p-3 bg-info bg-opacity-10 text-info rounded-circle">
                    <i class="bi bi-person-lines-fill fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card crm-card p-3 h-100 border-start border-4 border-warning">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small text-uppercase fw-semibold">Upcoming Tasks</span>
                    <h3 class="fw-bold text-dark mb-0 mt-1">@Model.UpcomingFollowUps</h3>
                    <small class="text-danger"><i class="bi bi-alarm me-1"></i>@Model.OverdueFollowUps Overdue</small>
                </div>
                <div class="p-3 bg-warning bg-opacity-10 text-warning rounded-circle">
                    <i class="bi bi-calendar-event fs-4"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- KPI Cards Row 2: Opportunities Breakdown -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card crm-card p-3 text-center">
            <span class="text-muted small">Total Opportunities</span>
            <h4 class="fw-bold text-dark mt-1 mb-0">@Model.TotalOpportunities</h4>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card crm-card p-3 text-center">
            <span class="text-muted small">Open Deals</span>
            <h4 class="fw-bold text-primary mt-1 mb-0">@Model.OpenOpportunities</h4>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card crm-card p-3 text-center">
            <span class="text-muted small">Deals Won</span>
            <h4 class="fw-bold text-success mt-1 mb-0">@Model.WonOpportunities</h4>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card crm-card p-3 text-center">
            <span class="text-muted small">Deals Lost</span>
            <h4 class="fw-bold text-secondary mt-1 mb-0">@Model.LostOpportunities</h4>
        </div>
    </div>
</div>

<!-- Charts Section -->
<div class="row g-4 mb-4">
    <div class="col-lg-4">
        <div class="card crm-card h-100 p-3">
            <h6 class="fw-bold text-dark mb-3">
                <i class="bi bi-pie-chart-fill text-primary me-2"></i>Lead Status Breakdown
            </h6>
            <div style="position: relative; height: 260px;">
                <canvas id="leadStatusChart"></canvas>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card crm-card h-100 p-3">
            <h6 class="fw-bold text-dark mb-3">
                <i class="bi bi-bar-chart-steps text-info me-2"></i>Opportunity Pipeline Stages ($)
            </h6>
            <div style="position: relative; height: 260px;">
                <canvas id="pipelineStageChart"></canvas>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card crm-card h-100 p-3">
            <h6 class="fw-bold text-dark mb-3">
                <i class="bi bi-graph-up-arrow text-success me-2"></i>Monthly Sales Trend
            </h6>
            <div style="position: relative; height: 260px;">
                <canvas id="monthlyTrendChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Recent Items Row -->
<div class="row g-4">
    <!-- Upcoming Follow-Ups -->
    <div class="col-lg-6">
        <div class="card crm-card h-100">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0"><i class="bi bi-clock-history me-2 text-primary"></i>Upcoming Follow-Ups</h6>
                <a asp-controller="FollowUps" asp-action="Index" class="btn btn-outline-primary btn-sm">View All</a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Subject</th>
                            <th>Date</th>
                            <th>Type</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.RecentFollowUps.Any())
                        {
                            @foreach (var f in Model.RecentFollowUps)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold">@f.Subject</div>
                                        <small class="text-muted">@(f.Customer?.CustomerName ?? f.Lead?.LeadName ?? "General")</small>
                                    </td>
                                    <td>
                                        <small>@f.FollowUpDate.ToString("g")</small>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary">@f.FollowUpType</span>
                                    </td>
                                    <td>
                                        <form asp-controller="FollowUps" asp-action="Complete" asp-route-id="@f.FollowUpId" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-success" title="Mark Complete">
                                                <i class="bi bi-check-lg"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">
                                    <i class="bi bi-check2-circle text-success fs-3 d-block mb-1"></i>
                                    No pending follow-ups scheduled.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Top Opportunities -->
    <div class="col-lg-6">
        <div class="card crm-card h-100">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0"><i class="bi bi-trophy text-warning me-2"></i>Top Open Opportunities</h6>
                <a asp-controller="Opportunities" asp-action="Index" class="btn btn-outline-primary btn-sm">View All</a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Opportunity</th>
                            <th>Customer</th>
                            <th>Amount</th>
                            <th>Stage</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.TopOpportunities.Any())
                        {
                            @foreach (var o in Model.TopOpportunities)
                            {
                                <tr>
                                    <td class="fw-semibold">
                                        <a asp-controller="Opportunities" asp-action="Details" asp-route-id="@o.OpportunityId" class="text-decoration-none">
                                            @o.OpportunityName
                                        </a>
                                    </td>
                                    <td>@(o.Customer?.CustomerName ?? "N/A")</td>
                                    <td class="fw-bold text-success">@o.Amount.ToString("C0")</td>
                                    <td>
                                        <span class="badge bg-primary">@o.Stage</span>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">
                                    No active opportunities found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // 1. Lead Status Chart
        const leadStatusCtx = document.getElementById('leadStatusChart').getContext('2d');
        new Chart(leadStatusCtx, {
            type: 'doughnut',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LeadStatusCounts.Keys)),
                datasets: [{
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LeadStatusCounts.Values)),
                    backgroundColor: ['#3b82f6', '#06b6d4', '#10b981', '#ef4444', '#8b5cf6'],
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'bottom' }
                }
            }
        });

        // 2. Opportunity Stage Chart
        const pipelineCtx = document.getElementById('pipelineStageChart').getContext('2d');
        new Chart(pipelineCtx, {
            type: 'bar',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.StagePipelineAmounts.Keys)),
                datasets: [{
                    label: 'Amount ($)',
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.StagePipelineAmounts.Values)),
                    backgroundColor: '#2563eb',
                    borderRadius: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    y: { beginAtZero: true }
                }
            }
        });

        // 3. Monthly Sales Trend Chart
        const monthlyCtx = document.getElementById('monthlyTrendChart').getContext('2d');
        new Chart(monthlyCtx, {
            type: 'line',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyTrends.Select(m => m.Month))),
                datasets: [
                    {
                        label: 'Won ($)',
                        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyTrends.Select(m => m.WonAmount))),
                        borderColor: '#10b981',
                        backgroundColor: 'rgba(16, 185, 129, 0.1)',
                        tension: 0.3,
                        fill: true
                    },
                    {
                        label: 'Open Pipeline ($)',
                        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyTrends.Select(m => m.PipelineAmount))),
                        borderColor: '#3b82f6',
                        backgroundColor: 'rgba(59, 130, 246, 0.1)',
                        tension: 0.3,
                        fill: true
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'bottom' }
                },
                scales: {
                    y: { beginAtZero: true }
                }
            }
        });
    </script>
}
