<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AcxiomCRM</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        :root {
            --crm-sidebar-bg: #0f172a;
            --crm-sidebar-hover: #1e293b;
            --crm-sidebar-active: #2563eb;
            --crm-sidebar-text: #cbd5e1;
            --crm-primary: #1d4ed8;
            --crm-bg: #f8fafc;
        }
        body {
            background-color: var(--crm-bg);
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", sans-serif;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }
        .crm-wrapper {
            display: flex;
            flex: 1;
        }
        .crm-sidebar {
            width: 250px;
            background-color: var(--crm-sidebar-bg);
            color: var(--crm-sidebar-text);
            min-height: calc(100vh - 60px);
            transition: all 0.3s;
        }
        .crm-sidebar .nav-link {
            color: var(--crm-sidebar-text);
            padding: 0.75rem 1.25rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            font-size: 0.92rem;
            border-radius: 6px;
            margin: 2px 10px;
            transition: background-color 0.2s, color 0.2s;
        }
        .crm-sidebar .nav-link:hover {
            background-color: var(--crm-sidebar-hover);
            color: #ffffff;
        }
        .crm-sidebar .nav-link.active {
            background-color: var(--crm-sidebar-active);
            color: #ffffff;
            font-weight: 600;
        }
        .crm-sidebar .sidebar-heading {
            font-size: 0.72rem;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: #64748b;
            padding: 1rem 1.25rem 0.4rem;
            font-weight: 700;
        }
        .crm-main-content {
            flex: 1;
            padding: 1.5rem 2rem;
            overflow-x: hidden;
        }
        .navbar-brand-custom {
            font-weight: 800;
            letter-spacing: -0.02em;
            color: #1e3a8a !important;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        .crm-card {
            border: 1px solid #e2e8f0;
            border-radius: 0.625rem;
            box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.05);
            background: #ffffff;
        }
        .table-custom th {
            background-color: #f1f5f9;
            color: #475569;
            font-size: 0.82rem;
            text-transform: uppercase;
            letter-spacing: 0.03em;
            font-weight: 600;
            border-bottom: 2px solid #cbd5e1;
        }
        .badge-status {
            font-size: 0.78rem;
            padding: 0.35em 0.65em;
            font-weight: 600;
        }
    </style>
</head>
<body>
    <!-- Top Header -->
    <header class="navbar navbar-expand-lg navbar-light bg-white border-bottom sticky-top py-2 px-3 shadow-sm">
        <div class="container-fluid">
            <a class="navbar-brand navbar-brand-custom" asp-controller="Dashboard" asp-action="Index">
                <i class="bi bi-diagram-3-fill text-primary fs-4"></i>
                <span>Acxiom<span class="text-primary">CRM</span></span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#sidebarCollapse" aria-controls="sidebarCollapse">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="ms-auto d-flex align-items-center">
                <partial name="_LoginPartial" />
            </div>
        </div>
    </header>

    <div class="crm-wrapper">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <!-- Navigation Sidebar -->
            <nav class="crm-sidebar d-none d-lg-block" id="sidebarCollapse">
                <div class="py-3">
                    <div class="sidebar-heading">Core CRM</div>
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")" asp-controller="Dashboard" asp-action="Index">
                                <i class="bi bi-speedometer2"></i> Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Customers" ? "active" : "")" asp-controller="Customers" asp-action="Index">
                                <i class="bi bi-people-fill"></i> Customers
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Leads" ? "active" : "")" asp-controller="Leads" asp-action="Index">
                                <i class="bi bi-funnel-fill"></i> Leads
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Opportunities" ? "active" : "")" asp-controller="Opportunities" asp-action="Index">
                                <i class="bi bi-cash-coin"></i> Opportunities
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "FollowUps" ? "active" : "")" asp-controller="FollowUps" asp-action="Index">
                                <i class="bi bi-calendar2-check-fill"></i> Follow-Ups
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Activities" ? "active" : "")" asp-controller="Activities" asp-action="Index">
                                <i class="bi bi-card-checklist"></i> Activities
                            </a>
                        </li>
                    </ul>

                    <div class="sidebar-heading">Intelligence</div>
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" ? "active" : "")" asp-controller="Reports" asp-action="Index">
                                <i class="bi bi-bar-chart-fill"></i> Reports & Pipeline
                            </a>
                        </li>
                    </ul>

                    @if (User.IsInRole(UserRoles.Admin) || User.IsInRole(UserRoles.Manager))
                    {
                        <div class="sidebar-heading">Administration</div>
                        <ul class="nav flex-column">
                            @if (User.IsInRole(UserRoles.Admin))
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Users" ? "active" : "")" asp-controller="Users" asp-action="Index">
                                        <i class="bi bi-person-gear"></i> User & Roles
                                    </a>
                                </li>
                            }
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "AuditLogs" ? "active" : "")" asp-controller="AuditLogs" asp-action="Index">
                                    <i class="bi bi-shield-check"></i> Audit Logs
                                </a>
                            </li>
                        </ul>
                    }
                </div>
            </nav>
        }

        <!-- Main Body -->
        <main class="crm-main-content">
            <!-- Toast / Alerts -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @RenderBody()
        </main>
    </div>

    <!-- Footer -->
    <footer class="border-top py-3 text-muted text-center small bg-white mt-auto">
        <div class="container-fluid">
            &copy; 2026 <strong>AcxiomCRM</strong>. Enterprise Customer-Sales Lifecycle Platform.
        </div>
    </footer>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.20.0/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
