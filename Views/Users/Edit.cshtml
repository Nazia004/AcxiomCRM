@model EditUserViewModel
@{
    ViewData["Title"] = "Edit User: " + Model.FullName;
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card crm-card p-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4 class="fw-bold mb-0"><i class="bi bi-person-gear text-primary me-2"></i>Edit User: @Model.FullName</h4>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back</a>
            </div>

            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="Email" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                <div class="mb-3">
                    <label class="form-label fw-semibold small">Email Address</label>
                    <input value="@Model.Email" class="form-control" disabled />
                </div>

                <div class="mb-3">
                    <label asp-for="FullName" class="form-label fw-semibold small"></label> <span class="text-danger">*</span>
                    <input asp-for="FullName" class="form-control" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Role" class="form-label fw-semibold small"></label> <span class="text-danger">*</span>
                    <select asp-for="Role" class="form-select">
                        <option value="Admin" selected="@(Model.Role == "Admin")">Admin</option>
                        <option value="Manager" selected="@(Model.Role == "Manager")">Manager</option>
                        <option value="SalesExecutive" selected="@(Model.Role == "SalesExecutive")">SalesExecutive</option>
                    </select>
                </div>

                <div class="mb-4 form-check">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label small"></label>
                </div>

                <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4 fw-semibold">
                        <i class="bi bi-save me-1"></i>Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
