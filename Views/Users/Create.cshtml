@model CreateUserViewModel
@{
    ViewData["Title"] = "Create User Account";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card crm-card p-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4 class="fw-bold mb-0"><i class="bi bi-person-plus text-primary me-2"></i>Provision User Account</h4>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back</a>
            </div>

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="FullName" class="form-label fw-semibold small"></label> <span class="text-danger">*</span>
                    <input asp-for="FullName" class="form-control" placeholder="User Full Name" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-semibold small"></label> <span class="text-danger">*</span>
                    <input asp-for="Email" class="form-control" placeholder="user@acxiomcrm.com" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label fw-semibold small"></label> <span class="text-danger">*</span>
                    <input asp-for="Password" class="form-control" placeholder="At least 8 characters" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Role" class="form-label fw-semibold small"></label> <span class="text-danger">*</span>
                    <select asp-for="Role" class="form-select">
                        <option value="Admin">Admin (Full System Access)</option>
                        <option value="Manager">Manager (Team Management & Reports)</option>
                        <option value="SalesExecutive">SalesExecutive (Assigned Records Only)</option>
                    </select>
                </div>

                <div class="mb-4 form-check">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label small"></label>
                </div>

                <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4 fw-semibold">
                        <i class="bi bi-person-check me-1"></i>Create User
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
