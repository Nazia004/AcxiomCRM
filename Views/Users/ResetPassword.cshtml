@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
}

<div class="row justify-content-center">
    <div class="col-lg-5">
        <div class="card crm-card p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="fw-bold mb-0"><i class="bi bi-key text-warning me-2"></i>Reset User Password</h4>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back</a>
            </div>
            <p class="text-muted small mb-4">Set a new compliant password for user account <strong>@Model.Email</strong>.</p>

            <form asp-action="ResetPassword" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="UserId" />
                <input type="hidden" asp-for="Email" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label fw-semibold small"></label> <span class="text-danger">*</span>
                    <input asp-for="NewPassword" class="form-control" placeholder="At least 8 characters" />
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label fw-semibold small"></label> <span class="text-danger">*</span>
                    <input asp-for="ConfirmPassword" class="form-control" placeholder="Repeat new password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-warning px-4 fw-semibold">
                        <i class="bi bi-check2-circle me-1"></i>Apply Password
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
